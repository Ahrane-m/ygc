OPENAI_API_KEY=sk-proj-your-openai-api-key
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
MONGODB_URI=mongodb+srv://user:password@your-cluster.mongodb.net/mediscan?retryWrites=true&w=majority
JWT_SECRET=your-jwt-signing-secret

NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password
NEO4J_DATABASE=neo4j

# Optional. Commented out so copying this file gives you exactly the set of
# variables above; graph_db.py falls back to these same defaults when unset.
# Tuned for a managed Neo4j instance (Aura) that closes idle connections —
# lower NEO4J_MAX_CONNECTION_LIFETIME if you still see "Failed to read from
# defunct connection" / "Unable to retrieve routing information".
# NEO4J_MAX_CONNECTION_LIFETIME=300
# NEO4J_LIVENESS_CHECK_TIMEOUT=30
# NEO4J_CONNECTION_ACQUISITION_TIMEOUT=30
# NEO4J_MAX_TRANSACTION_RETRY_TIME=15

# Optional, used elsewhere in the pipeline:
# QA_CONTEXT_BUDGET_CHARS=48000   # retrieval.py — context size before narrowing
# MONGODB_TIMEOUT_MS=8000         # db.py — server-selection timeout

# Demo/placeholder handling.
# The upload API NEVER skips a page for matching a demo/placeholder marker
# (DEMO, SAMPLE, TEST PATIENT, and non-English equivalents). Demo and real
# documents are both added; matching pages are tagged is_demo_document=true
# and listed in the response's demo_documents field.
# This setting now only affects the offline CLI path
# (medical_extractor.group_documents_by_patient).
SKIP_DEMO_DOCUMENTS=false
